# Copy your .env to .env.docker (gitignored) and change localhost ->
# host.docker.internal in the two DATABASE_URL_* values so the backend
# container can reach PostgreSQL on the host.
#
# docker compose loads .env first, then .env.docker (overrides only).
# Example of the two overridden lines (placeholders — no real secrets here):
# DATABASE_URL_TEST=postgresql://user:password@host.docker.internal:5432/novel_reader_test
# DATABASE_URL_PRODUCTION=postgresql://user:password@host.docker.internal:5432/novel_reader_production
