# Copy to .env (gitignored) and fill real values. NEVER commit .env.
APP_NAME=Inkwell Novel Reader
ENVIRONMENT=local

# Empty Postgres databases supplied by the project owner. Placeholders only here.
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/novel_reader_test
DATABASE_URL_PRODUCTION=postgresql://user:password@localhost:5432/novel_reader_production

# Use a long random string in the real .env
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=14

# Seeded only when admin_users is empty. After a password change via the web UI, these stop working.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Relative to this file's directory (novel_reader/)
NOVEL_ROOT=../drafts/Novel
MANHWA_ROOT=../drafts/Manhwa
CORS_ORIGINS=http://localhost:5173
